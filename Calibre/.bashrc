# Locale environment variables
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

# Calibre variables
export CALIBRE_CONFIG_DIRECTORY="/etc/calibre"

# libgourou variables
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/lib

# Command aliases
alias c='clear'
alias cls='clear'

alias ls='ls --color'
alias l='ls'
alias la='ls -a'
alias ll='ls -l'
